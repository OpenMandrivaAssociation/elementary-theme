From: OpenMandriva packaging
Subject: scrollbar: use theme colors, not a fixed green

Original patch removed murrine scrollbar_color = "#6DAA53" so scrollbars
followed the theme instead of a hardcoded green. Upstream 8.x rewrote the
theme in SCSS; rebase keeps theme-driven scrollbar colors via @theme_fg_color
for GTK 3 and GTK 4 stylesheets.

--- a/src/gtk-3.0/widgets/_scrollbars.scss
+++ b/src/gtk-3.0/widgets/_scrollbars.scss
@@ -26,7 +26,8 @@
 
     slider {
         background-clip: padding-box;
-        background-color: rgba($fg-color, 0.6);
+        /* theme-colored scrollbar (not a fixed palette green) */
+        background-color: #{'alpha(@theme_fg_color, 0.6)'};
         border: 1px solid rgba(bg-color(2), 0.25);
         border-radius: rem(10px);
         margin: 1px;
@@ -68,7 +69,7 @@
 
         &:hover trough,
         &.hovering trough {
-            background-color: rgba($fg-color, 0.1);
+            background-color: #{'alpha(@theme_fg_color, 0.1)'};
         }
     }
 
--- a/src/gtk-4.0/widgets/_scrollbars.scss
+++ b/src/gtk-4.0/widgets/_scrollbars.scss
@@ -20,7 +20,8 @@
 
     slider {
         background-clip: padding-box;
-        background-color: rgba($fg-color, 0.6);
+        /* theme-colored scrollbar (not a fixed palette green) */
+        background-color: #{'alpha(@theme_fg_color, 0.6)'};
         border: 1px solid rgba(bg-color(2), 0.25);
         border-radius: rem(10px);
         margin: 1px;
@@ -63,7 +64,7 @@
 
         &:hover trough,
         &.hovering trough {
-            background-color: rgba($fg-color, 0.1);
+            background-color: #{'alpha(@theme_fg_color, 0.1)'};
         }
     }
 
